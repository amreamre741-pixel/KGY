generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER // sees and manages everything in every store
  MANAGER // manages his own store
  SELLER // searches and sells; never sees purchase prices
}

enum VehicleType {
  CAR
  TRUCK
}

enum MovementType {
  IN // stock received manually
  OUT // stock removed manually
  ADJUST // inventory count correction
  IMPORT // Excel import
  INITIAL // initial stock when a part is created
  SALE // sold at POS
  RETURN // returned by customer
  PURCHASE // received via supplier purchase invoice
  TRANSFER_OUT // sent to another store
  TRANSFER_IN // received from another store
}

model Store {
  id        String   @id @default(cuid())
  name      String
  address   String   @default("")
  phone     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  stocks           Stock[]
  movements        StockMovement[]
  sales            Sale[]
  payments         CustomerPayment[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  orderNotes       OrderNote[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(SELLER)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements        StockMovement[]
  sales            Sale[]
  payments         CustomerPayment[]
  purchases        Purchase[]
  supplierPayments SupplierPayment[]
  transfers        StockTransfer[]
  orderNotes       OrderNote[]
}

model Category {
  id     String @id @default(cuid())
  nameAr String @unique
  nameEn String @default("")
  parts  Part[]
}

model Part {
  id            String    @id @default(cuid())
  reference     String // OEM / manufacturer reference as typed
  refNorm       String // reference uppercased, without spaces/dashes/dots (for search)
  barcode       String?   @unique
  nameAr        String
  nameEn        String    @default("")
  brand         String    @default("")
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2)
  salePrice     Decimal   @default(0) @db.Decimal(12, 2)
  dimensions    String    @default("") // e.g. "30x62x16 mm" / "M12x1.5"
  dimNorm       String    @default("") // normalized dimensions for flexible mm search
  imageUrl      String    @default("")
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  compat        VehicleCompat[]
  stocks        Stock[]
  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  transferItems StockTransferItem[]

  @@unique([reference, brand])
  @@index([refNorm])
  @@index([dimNorm])
}

model VehicleCompat {
  id       String      @id @default(cuid())
  partId   String
  part     Part        @relation(fields: [partId], references: [id], onDelete: Cascade)
  type     VehicleType @default(CAR)
  make     String
  model    String      @default("")
  yearFrom Int?
  yearTo   Int?

  @@index([make, model])
}

model Stock {
  id          String @id @default(cuid())
  partId      String
  part        Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quantity    Int    @default(0)
  minQuantity Int    @default(0)
  location    String @default("")

  @@unique([partId, storeId])
}

model StockMovement {
  id        String       @id @default(cuid())
  partId    String
  part      Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      MovementType
  quantity  Int // signed change (+ in, - out)
  after     Int // quantity in store after the movement
  note      String       @default("")
  createdAt DateTime     @default(now())

  @@index([partId, createdAt])
  @@index([storeId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  balance   Decimal  @default(0) @db.Decimal(12, 2) // positive = customer owes us (credit)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
}

model Sale {
  id             String    @id @default(cuid())
  number         String    @unique
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal       Decimal   @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  paidAmount     Decimal   @db.Decimal(12, 2)
  debtAmount     Decimal   @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  note           String    @default("")
  createdAt      DateTime  @default(now())

  items SaleItem[]

  @@index([storeId, createdAt])
  @@index([customerId, createdAt])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  partId        String?
  part          Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  partName      String
  reference     String
  quantity      Int
  returnedQty   Int     @default(0)
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  unitPrice     Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
}

model CustomerPayment {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([customerId, createdAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  balance   Decimal  @default(0) @db.Decimal(12, 2) // positive = we owe this supplier
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([name])
}

model Purchase {
  id          String    @id @default(cuid())
  number      String    @unique
  supplierRef String    @default("") // supplier's paper invoice #
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  total       Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @db.Decimal(12, 2)
  debtAmount  Decimal   @default(0) @db.Decimal(12, 2)
  note        String    @default("")
  createdAt   DateTime  @default(now())

  items PurchaseItem[]

  @@index([storeId, createdAt])
  @@index([supplierId, createdAt])
}

model PurchaseItem {
  id        String   @id @default(cuid())
  purchaseId String
  purchase  Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partId    String?
  part      Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  partName  String
  reference String
  quantity  Int
  unitCost  Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
}

model SupplierPayment {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @db.Decimal(12, 2)
  note         String   @default("")
  createdAt    DateTime @default(now())

  @@index([supplierId, createdAt])
}

model StockTransfer {
  id          String   @id @default(cuid())
  number      String   @unique
  fromStoreId String
  fromStore   Store    @relation("TransferFrom", fields: [fromStoreId], references: [id], onDelete: Restrict)
  toStoreId   String
  toStore     Store    @relation("TransferTo", fields: [toStoreId], references: [id], onDelete: Restrict)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note        String   @default("")
  createdAt   DateTime @default(now())

  items StockTransferItem[]

  @@index([fromStoreId, createdAt])
  @@index([toStoreId, createdAt])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  partId     String?
  part       Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  partName   String
  reference  String
  quantity   Int
  toLocation String        @default("")
}

enum OrderNoteStatus {
  PENDING
  DONE
}

model OrderNote {
  id          String          @id @default(cuid())
  storeId     String?
  store       Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  partName    String
  reference   String          @default("")
  vehicle     String          @default("")
  quantity    Int             @default(1)
  customerInfo String         @default("")
  note        String          @default("")
  status      OrderNoteStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([storeId, createdAt])
}

