# PostgreSQL connection string (Railway / Render / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/kgy?schema=public"

# Long random secret (at least 32 chars) used to sign session cookies
SESSION_SECRET="replace-with-a-strong-32-character-secret-key"

# Default owner password used only on first `npm run db:seed`
OWNER_PASSWORD="change-me-immediately"

# Optional: Gemini API key for OCR/AI reference reading in Search-by-Image
# (Visual shape/color matching works even without this key)
GEMINI_API_KEY=""
